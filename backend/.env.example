# Copy this file to .env (same folder) and adjust if needed.
# .env is ignored by git, so real passwords and keys never get committed.

# The app's database (matches docker-compose.yml)
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint

# The database pytest uses (it gets wiped on every test run)
TEST_DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint_test

# Websites allowed to call the API (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:8080,https://ali-fathi-st.github.io

# Where uploaded résumés and cover letters are stored (private; never served)
STORAGE_DIR=storage

# Adzuna job search (optional). Get free keys at https://developer.adzuna.com
# Leave blank to use only Greenhouse and Lever, which need no keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca

# Host names the API answers to (protects a server running on your computer)
ALLOWED_HOSTS=localhost,127.0.0.1
